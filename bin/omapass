#!/bin/bash

# omapass — pass(1) backend for the omapass Omarchy shell plugin.
#
# The shell plugin never handles a decrypted password itself: every action that
# touches a secret happens in here, and the secret goes straight from gpg to the
# clipboard or to wtype. The only exception is `reveal`, which the user has to
# ask for explicitly.
#
# Secrets are passed between functions in bash variables, never in argv, so they
# never appear in /proc/*/cmdline.

set -euo pipefail

# Config, shared with the other scripts in bin/.
OMAPASS_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck source=../lib/config.sh
source "$OMAPASS_LIB/config.sh"

# --- logging ----------------------------------------------------------------
#
# Off unless asked for. The rule is that this file can be pasted into a bug
# report without a second thought, so it records what happened and never what
# it happened to: no passwords, no usernames, no URLs, and no entry names.
#
# Entry names are omitted because they are themselves disclosure — a log
# listing "bank/deutsche-bank" says which bank you use. They appear as a short
# digest salted per run, which is enough to see that three lines concern the
# same entry without saying which entry that is, and is meaningless once the
# run ends.

LOG_SALT=""

log_digest() {
  local value="$1"
  [[ -n $value ]] || { printf -- '-'; return; }
  [[ -n $LOG_SALT ]] || LOG_SALT=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  printf '%s' "$LOG_SALT$value" | sha256sum | cut -c1-8
}

# Keeps the file bounded: past the limit the current log becomes .1, replacing
# any previous .1, so a long-running session cannot fill a disk.
log_rotate() {
  local max_kb size
  max_kb=$(config_number log-max-kb 256)
  [[ -f $LOG_FILE ]] || return 0
  size=$(du -k "$LOG_FILE" 2>/dev/null | cut -f1)
  [[ ${size:-0} -ge $max_kb ]] || return 0
  mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null || true
  : >"$LOG_FILE"
  chmod 600 "$LOG_FILE" 2>/dev/null || true
}

log_line() {
  $LOG_ENABLED || return 0
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || return 0
  if [[ ! -e $LOG_FILE ]]; then
    : >"$LOG_FILE"
    chmod 600 "$LOG_FILE" 2>/dev/null || true
  fi
  log_rotate
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ)" "$*" >>"$LOG_FILE" 2>/dev/null || true
}

# Stop the plugin: the bar icon goes, the hotkey stops doing anything, and the
# shell unloads it. Everything stays installed — this is "quit", not "uninstall"
# — so a single command brings it all back, and that command is printed because
# a quit you cannot undo without reading the manual is a trap.
# Answers "which copy of omapass is actually running, and is logging on?" —
# the questions that cost a round trip every time something behaves unexpectedly.
cmd_doctor() {
  local id plugins_dir found=0 dir
  id=$(manifest_field id)
  id="${id:-cschaba.omapass}"
  plugins_dir="$HOME/.config/omarchy/plugins"

  echo "omapass $(omapass_version)"
  echo "  running from   $OMAPASS_ROOT"
  echo "  plugin id      $id"
  echo "  config         $CONFIG_FILE$([[ -r $CONFIG_FILE ]] || echo '  (none — using defaults)')"
  echo "  store          $STORE"
  echo "  log            $($LOG_ENABLED && echo "on → $LOG_FILE" || echo 'off  (set log = on in the config)')"
  echo

  # Two directories declaring the same id is the trap: omarchy loads one of
  # them and there is nothing on screen to say which.
  echo "installed plugin directories:"
  if [[ -d $plugins_dir ]]; then
    for dir in "$plugins_dir"/*/; do
      [[ -f "$dir/manifest.json" ]] || continue
      local dir_id dir_version
      dir_id=$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/manifest.json" | head -1)
      dir_version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/manifest.json" | head -1)
      [[ $dir_id == "$id" ]] || continue
      found=$((found + 1))
      printf '  %s  (%s)%s\n' "${dir%/}" "$dir_version" \
        "$([[ "$(readlink -f "${dir%/}")" == "$(readlink -f "$OMAPASS_ROOT")" ]] && echo '  ← this one')"
    done
  fi
  [[ $found -gt 0 ]] || echo "  none found under $plugins_dir"

  # The question doctor could not answer until now. Everything above reads the
  # files on disk; the shell runs whatever QML it loaded at startup and keeps
  # it for the life of the process. Update the files and the CLI goes current
  # immediately while the interface does not — which looks exactly like a fix
  # that did not work.
  local pid started stale
  pid=$(pgrep -f 'quickshell -n -p' 2>/dev/null | head -1)
  if [[ -n $pid ]]; then
    started=$(( $(date +%s) - $(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ') ))
    stale=$(find "$OMAPASS_ROOT" -maxdepth 1 \( -name '*.qml' -o -name '*.js' \) \
      -newermt "@$started" -printf '%P ' 2>/dev/null)
    echo
    if [[ -n $stale ]]; then
      echo "  ! The running shell is older than the interface files on disk."
      echo "  ! Changed since it started: ${stale% }"
      echo "  ! The CLI below is current but the windows are not."
      echo "  ! Fix with:  omarchy restart shell"
    else
      echo "interface: the running shell matches the files on disk"
    fi
  fi

  if [[ $found -gt 1 ]]; then
    echo
    echo "  ! $found directories declare the plugin id '$id'."
    echo "  ! omarchy loads one of them and gives no sign which, so the version"
    echo "  ! you see may not be the code that runs. Remove the ones you do not"
    echo "  ! want and restart with: omarchy restart shell"
  fi
}

cmd_quit() {
  local id
  id=$(manifest_field id)
  id="${id:-cschaba.omapass}"

  if command -v omarchy >/dev/null 2>&1 && omarchy plugin disable "$id" >/dev/null 2>&1; then
    :
  elif ! omarchy-shell shell setPluginEnabled "$id" false >/dev/null 2>&1; then
    die "could not stop the plugin — is omarchy-shell running?"
  fi

  echo "omapass stopped. It is still installed."
  echo "Start it again with:  omarchy plugin enable $id"
}

cmd_log() {
  case "${1:-}" in
  --path) printf '%s\n' "$LOG_FILE" ;;
  --clear)
    rm -f "$LOG_FILE" "$LOG_FILE.1"
    echo "omapass: log cleared"
    ;;
  --event)
    shift
    # The UI half of the app has no other way into this file, and a failure
    # that happens in QML is invisible to a log written only by the CLI —
    # which is how #21 cost two rounds of guessing.
    log_line "ui: $*"
    ;;
  --status | "")
    printf '{"enabled":%s,"path":"%s","exists":%s,"bytes":%s,"maxKb":%s}\n' \
      "$($LOG_ENABLED && echo true || echo false)" \
      "$(json_escape "$LOG_FILE")" \
      "$([[ -f $LOG_FILE ]] && echo true || echo false)" \
      "$([[ -f $LOG_FILE ]] && stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)" \
      "$(config_number log-max-kb 256)"
    ;;
  *) die "unknown log option: $1" ;;
  esac
}

# A detached action has nowhere to put an error. Nothing reads its stderr, and
# by the time it runs the surface that started it has already closed — so a
# failure looks exactly like a key that did nothing, which is how "copy user is
# broken" gets reported for an entry that simply has no username field. Only
# the fire-and-forget commands set this; the editor's writes already surface
# their stderr in the UI and would otherwise say everything twice. (#31)
NOTIFY_ERRORS=false

die() {
  local message="$*"
  echo "omapass: $message" >&2
  # The log redacts; a notification is on the user's own screen, about their
  # own entry, and is useless without the detail.
  # An if, not `$NOTIFY_ERRORS && notify`: under errexit the false branch of an
  # and-list fails the whole list, which would leave die() before it logged.
  if $NOTIFY_ERRORS; then notify "omapass" "$message" "󰀦"; fi

  # The terminal gets the real message; the log gets it with every argument
  # this command was given substituted out. Redacting the actual values beats
  # trying to keep names out of die() strings by hand — "no such entry: $entry"
  # is exactly the message worth having, and exactly the one that would leak.
  local arg
  for arg in "${LOG_ARGS[@]}"; do
    [[ -n $arg ]] || continue
    message="${message//"$arg"/<redacted>}"
  done
  log_line "error: $message"
  exit 1
}

notify() {
  local title="$1" body="${2:-}" glyph="${3:-󰌾}"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send --app-name omapass -g "$glyph" -t 3000 "$title" "$body" >/dev/null 2>&1 || true
}

require_pass() {
  command -v pass >/dev/null 2>&1 || die "pass is not installed"
  [[ -d $STORE ]] || die "no password store at $STORE"
}

# Reject anything that could climb out of the store or hit a shell.
validate_entry() {
  local entry="$1"
  [[ -n $entry ]] || die "empty entry name"
  [[ $entry != /* ]] || die "entry must be relative: $entry"
  [[ $entry != *..* ]] || die "entry may not contain '..': $entry"
  # Any control character, not just newline: a tab or carriage return in a name
  # produces a file nobody can refer to again.
  LC_ALL=C grep -q '[[:cntrl:]]' <<<"$entry" && die "entry may not contain control characters"
  # A leading dash makes pass read the name as an option. The read paths happen
  # to be covered by the file-existence check, but insert/generate/mv have no
  # such guard, so reject it here and terminate options at every call site too.
  [[ $entry != -* ]] || die "entry may not start with '-': $entry"

  # Every path component becomes a directory or a filename, and the kernel caps
  # those at 255 bytes. Saying so beats letting the write fail with a filesystem
  # error nobody can connect back to the name they typed. (#9)
  local component
  while IFS= read -r component; do
    # An empty segment means a doubled or trailing slash: "a//b", "a/".
    [[ -n $component ]] || die "entry name has an empty path segment: $entry"

    # A leading dot would put the entry among the store's own dotfiles — and
    # ".git/..." writes inside the store's git repository, which is nobody's
    # idea of a password. This also covers "." and ".." on its own.
    [[ $component != .* ]] || die "entry name may not start with '.': $component"

    # Trailing space or dot round-trips badly across filesystems and is
    # invisible when reading the name back.
    [[ $component != *[[:space:]] && $component != *. ]] \
      || die "entry name may not end with a space or dot: $component"

    if [[ $(printf '%s' "$component" | wc -c) -gt 255 ]]; then
      die "entry name segment is too long (255 bytes max): ${component:0:40}…"
    fi
  done < <(tr '/' '\n' <<<"$entry")

  [[ $(printf '%s' "$entry" | wc -c) -le 4096 ]] || die "entry name is too long"
}

entry_exists() {
  [[ -f "$STORE/$1.gpg" ]]
}

# --- JSON helpers -----------------------------------------------------------

# `status` is the one command that has to work when the dependencies do not,
# since reporting a missing jq through jq would be a poor joke. Everything it
# emits is hand-rolled; the commands that genuinely need jq say so.

# Right by default, matching the manifest's defaultSection — said here as well
# so that `omapass config` answers the question rather than making the reader
# go and find the manifest.
config_bar_section() {
  local value="${OMAPASS_BAR_SECTION:-${CONFIG[bar-section]}}"
  case "$value" in
  left | center | right) printf '%s' "$value" ;;
  "") printf 'right' ;;
  *)
    config_warn "bar-section: '$value' is not left, center or right — using right"
    printf 'right'
    ;;
  esac
}

# The values actually in force, after file, environment and defaults have been
# resolved. The UI reads this rather than parsing the file itself.
config_json() {
  printf '{"path":"%s","exists":%s,' \
    "$(json_escape "$CONFIG_FILE")" \
    "$([[ -r $CONFIG_FILE ]] && echo true || echo false)"
  printf '"store":"%s","clipTime":%s,"typeDelay":%s,"typeFocusDelay":%s,' \
    "$(json_escape "$STORE")" \
    "$CLIP_TIME" "$TYPE_DELAY" \
    "${OMAPASS_TYPE_FOCUS_DELAY:-$(config_number type-focus-delay 0.2)}"
  printf '"draftTimeout":%s,' "$(config_number draft-timeout 300)"
  printf '"revealTimeout":%s,"fingerprint":"%s","fingerprintGrace":%s,"fingerprintRetries":%s,"pulldownRows":%s,' \
    "$(config_number reveal-timeout 15)" \
    "$(json_escape "${CONFIG[fingerprint]}")" \
    "$(config_number fingerprint-grace 120)" \
    "$(config_number fingerprint-retries 1)" \
    "$(config_number pulldown-rows 7)"
  printf '"barSection":"%s",' "$(json_escape "$(config_bar_section)")"
  printf '"backupDir":"%s","keybind":"%s","log":%s,"logPath":"%s"}' \
    "$(json_escape "$BACKUP_DIR")" \
    "$(json_escape "${OMAPASS_KEYBIND:-${CONFIG[keybind]}}")" \
    "$($LOG_ENABLED && echo true || echo false)" \
    "$(json_escape "$LOG_FILE")"
}

cmd_config() {
  case "${1:-}" in
  --path) printf '%s\n' "$CONFIG_FILE" ;;
  --init) write_config_template ;;
  "") config_json; echo ;;
  *) die "unknown config option: $1" ;;
  esac
}

write_config_template() {
  if [[ -e $CONFIG_FILE ]]; then
    echo "omapass: $CONFIG_FILE already exists, leaving it alone" >&2
    return 1
  fi
  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat >"$CONFIG_FILE" <<'TEMPLATE'
# omapass configuration
#
# Every setting is commented out at its default. Uncomment to change one.
# An environment variable of the same name still wins over this file, so a
# one-off run can override without editing anything.

# Where the password store lives. ~ is expanded.
# store = ~/.password-store

# Seconds a copied password stays on the clipboard before it is dropped.
# clip-time = 45

# Milliseconds between simulated keystrokes when typing into a window.
# type-delay = 12

# Seconds to wait for focus to land back on the target window before typing.
# Raise this if the first characters of a typed password go missing.
# type-focus-delay = 0.2

# Seconds a revealed password stays on screen before it re-hides.
# reveal-timeout = 15

# Seconds an unsaved entry form is kept when you close omapass with it open,
# so you can go and fetch a password from somewhere else and come back to it.
# The draft lives in memory only, is never written to disk, and is dropped on
# save, on cancel, and whenever the vault re-locks. Set to 0 to keep nothing.
# draft-timeout = 300

# Fingerprint unlock in front of the vault.
#   auto    require it when a finger is enrolled  (default)
#   always  require it whenever the PAM service exists, even if enrolment
#           cannot be confirmed
#   off     never require it
# Esc and the pass CLI always get you past the prompt, whatever this says.
# fingerprint = auto

# Seconds a successful fingerprint scan stays valid before it is asked for again.
# fingerprint-grace = 120

# How many failed fingerprint *attempts* to allow before falling back to the
# password prompt. One attempt is a whole fprintd conversation, and fprintd
# retries roughly three times inside each one — so the default of 1 is about
# three touches, which is the usual convention. Raise it if your reader is
# fussy; each extra costs another three touches.
# fingerprint-retries = 1

# Rows shown in the bar pulldown. A per-widget setting in shell.json,
# if you have one, wins over this.
# pulldown-rows = 7

# Which bar section the widget is placed in the first time it is installed:
# left, center or right. The default is right.
#
# This is an initial placement only. Once the widget is on the bar, Omarchy owns
# where it sits — move it with `omarchy bar move cschaba.omapass --section left`
# or from Setup → Plugins, and omapass will leave it alone.
# bar-section =

# Where omapass-reset writes its backups.
# backup-dir = ~/.local/state/omapass/backups

# Write a debug log to ~/.local/state/omapass/omapass.log. Off by default.
# The log records which operation ran and how it ended — never passwords,
# usernames, URLs, or entry names, so it is safe to attach to a bug report.
# log = off

# Size cap for that log. Past it the file is rotated once and started again.
# log-max-kb = 256

# The hotkey install.sh binds to open the overlay, in Hyprland's own syntax:
# modifiers, then the key. Re-run ./install.sh after changing it — the old
# binding is replaced, not duplicated.
#
# SUPER + CTRL + K is NOT a good choice: Omarchy already uses it.
# keybind = SUPER SHIFT, K
TEMPLATE
  echo "omapass: wrote $CONFIG_FILE"
}

# Whether the welcome screen has been shown. A marker file rather than a config
# key: it is state, not a preference, and the user should not have to unset
# something to be rid of it.
WELCOME_MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/omapass/welcomed"

cmd_welcomed() {
  case "${1:-}" in
  --mark)
    mkdir -p "$(dirname "$WELCOME_MARKER")"
    : >"$WELCOME_MARKER"
    ;;
  --reset) rm -f "$WELCOME_MARKER" ;;
  "") ;;
  *) die "unknown welcomed option: $1" ;;
  esac
  [[ -e $WELCOME_MARKER ]] && echo '{"welcomed":true}' || echo '{"welcomed":false}'
}

# --- requirements -----------------------------------------------------------

# Everything omapass needs at runtime, in the order a person would fix them.
# `hint` is the exact command to run, so the overlay can show instructions
# rather than just a red cross.
req_row() {
  local key="$1" label="$2" hint="$3" optional="$4" ok="$5"
  printf '{"key":"%s","label":"%s","hint":"%s","optional":%s,"ok":%s}' \
    "$(json_escape "$key")" "$(json_escape "$label")" "$(json_escape "$hint")" \
    "$optional" "$ok"
}

have() { command -v "$1" >/dev/null 2>&1 && printf 'true' || printf 'false'; }

secret_key_lines() {
  gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '
    $1 == "sec" { fpr = ""; uid = "" }
    $1 == "fpr" && fpr == "" { fpr = $10 }
    $1 == "uid" && uid == "" && fpr != "" { uid = $10; print fpr "\t" uid; fpr = "" }
  '
}

# Fingerprint unlock, detected exactly the way Omarchy's own lock screen does:
# the PAM service has to exist and a finger has to actually be enrolled.
# Touching a reader that has nothing enrolled would lock the user out of their
# own vault, so both halves are required.
fingerprint_available() {
  local mode="${CONFIG[fingerprint]}"

  # The marker file predates the config setting and still works, because it is
  # the easiest thing to create when a reader is refusing you entry.
  [[ ! -e ${XDG_CONFIG_HOME:-$HOME/.config}/omapass/no-fingerprint ]] || return 1

  case "$mode" in
  off) return 1 ;;
  auto | always) ;;
  *)
    config_warn "fingerprint: '$mode' is not auto, always or off — using auto"
    mode="auto"
    ;;
  esac

  [[ -f /etc/pam.d/omarchy-lock-fingerprint ]] || return 1

  # `always` trusts the PAM service alone, for readers fprintd-list does not
  # report cleanly. Esc and the pass CLI still get you past it.
  [[ $mode == "always" ]] && return 0

  command -v fprintd-list >/dev/null 2>&1 || return 1
  fprintd-list "$USER" 2>/dev/null | grep -qi finger || return 1
  return 0
}

cmd_status() {
  local has_pass has_gpg has_wlcopy has_wtype has_jq has_otp=false has_open=false
  has_pass=$(have pass)
  has_gpg=$(have gpg)
  has_wlcopy=$(have wl-copy)
  has_wtype=$(have wtype)
  has_jq=$(have jq)
  [[ $has_pass == "true" ]] && pass otp --help >/dev/null 2>&1 && has_otp=true
  # Either handler is enough; the browser launcher only covers http(s).
  { command -v xdg-open >/dev/null 2>&1 || command -v omarchy-launch-browser >/dev/null 2>&1; } && has_open=true

  local keys_raw has_key=false
  keys_raw=$(secret_key_lines)
  [[ -n $keys_raw ]] && has_key=true

  local has_fingerprint=false
  fingerprint_available && has_fingerprint=true

  # Whether the password fallback behind the fingerprint gate can work at all.
  # Without this service there is nothing to fall back to, and the UI has to say
  # so rather than offering a door that opens onto a wall.
  local has_password_auth=false
  [[ -f /etc/pam.d/omarchy-lock-password ]] && has_password_auth=true

  local has_store=false has_git=false entries=0
  [[ -f $STORE/.gpg-id ]] && has_store=true
  [[ -d $STORE/.git ]] && has_git=true
  if [[ $has_store == "true" ]]; then
    entries=$(find "$STORE" -name '*.gpg' -type f -not -path '*/.git/*' 2>/dev/null | wc -l)
  fi

  # The key id makes the store hint copy-pasteable instead of a placeholder.
  local key_hint="pass init <your-key-id>"
  if [[ $has_key == "true" ]]; then
    key_hint="pass init $(head -n1 <<<"$keys_raw" | cut -f1)"
  fi

  local rows=()
  rows+=("$(req_row pass       "pass CLI"                   "sudo pacman -S --needed pass"          false "$has_pass")")
  rows+=("$(req_row gpg        "GnuPG"                      "sudo pacman -S --needed gnupg"         false "$has_gpg")")
  rows+=("$(req_row wl-copy    "wl-clipboard (copying)"     "sudo pacman -S --needed wl-clipboard"  false "$has_wlcopy")")
  rows+=("$(req_row wtype      "wtype (typing into windows)" "sudo pacman -S --needed wtype"        false "$has_wtype")")
  rows+=("$(req_row jq         "jq"                         "sudo pacman -S --needed jq"            false "$has_jq")")
  rows+=("$(req_row key        "GPG key"                    "gpg --full-generate-key"               false "$has_key")")
  rows+=("$(req_row store      "Password store"             "$key_hint"                             false "$has_store")")
  rows+=("$(req_row pass-otp   "pass-otp (one-time codes)"  "sudo pacman -S --needed pass-otp"      true  "$has_otp")")
  rows+=("$(req_row xdg-open  "xdg-utils (opening urls)"   "sudo pacman -S --needed xdg-utils"     true  "$has_open")")

  local ready=true
  [[ $has_pass == "true" && $has_gpg == "true" && $has_wlcopy == "true" \
     && $has_wtype == "true" && $has_jq == "true" && $has_key == "true" \
     && $has_store == "true" ]] || ready=false

  local requirements
  requirements=$(IFS=,; printf '%s' "${rows[*]}")

  local keys="" sep=""
  while IFS=$'\t' read -r fpr uid; do
    [[ -n $fpr ]] || continue
    keys+="$sep{\"id\":\"$(json_escape "$fpr")\",\"uid\":\"$(json_escape "$uid")\"}"
    sep=","
  done <<<"$keys_raw"

  printf '{"version":"%s","id":"%s","name":"%s","homepage":"%s","welcomed":%s,"pass":%s,"otp":%s,"gpg":%s,"key":%s,"store":%s,"git":%s,"fingerprint":%s,"passwordAuth":%s,"open":%s,' \
    "$(json_escape "$(omapass_version)")" \
    "$(json_escape "$(manifest_field id)")" \
    "$(json_escape "$(manifest_field name)")" \
    "$(json_escape "$(manifest_field homepage)")" \
    "$([[ -e $WELCOME_MARKER ]] && echo true || echo false)" \
    "$has_pass" "$has_otp" "$has_gpg" "$has_key" "$has_store" "$has_git" "$has_fingerprint" \
    "$has_password_auth" "$has_open"
  printf '"entries":%s,"storePath":"%s","keys":[%s],' \
    "$entries" "$(json_escape "$STORE")" "$keys"
  printf '"requirements":[%s],"config":%s,"ready":%s}\n' \
    "$requirements" "$(config_json)" "$ready"
}

# Whether gpg-agent still holds a key, i.e. whether decrypting right now would
# raise a pinentry prompt. Best-effort: false is always the safe answer, and the
# detail pane simply stays closed until the user asks for it.
cmd_unlocked() {
  local cached=false out
  out=$(gpg-connect-agent 'keyinfo --list' /bye 2>/dev/null) || true
  if awk '$1 == "S" && $2 == "KEYINFO" && $7 == "1" { found = 1 } END { exit !found }' <<<"$out"; then
    cached=true
  fi
  printf '{"unlocked":%s}\n' "$cached"
}

# --- list -------------------------------------------------------------------

cmd_list() {
  require_pass
  find "$STORE" -name '*.gpg' -type f -not -path '*/.git/*' -printf '%P\n' 2>/dev/null |
    sed 's/\.gpg$//' |
    LC_ALL=C sort |
    jq -Rn '[inputs | select(length > 0) | {
      path: .,
      name: (split("/") | last),
      folder: (if (index("/")) then (split("/")[:-1] | join("/")) else "" end)
    }]'
}

# --- decrypt ----------------------------------------------------------------

# Echoes the full decrypted entry. Callers must keep it in a variable.
decrypt() {
  local entry="$1"
  validate_entry "$entry"
  entry_exists "$entry" || die "no such entry: $entry"
  pass show -- "$entry" 2>/dev/null || die "could not decrypt $entry"
}

# Everything after the first line, as key: value pairs. The password line is
# dropped before anything is printed, so it cannot leak into the shell process.
cmd_fields() {
  local entry="$1" body rest
  body=$(decrypt "$entry")
  rest=$(printf '%s\n' "$body" | tail -n +2)

  local has_otp=false
  printf '%s\n' "$rest" | grep -qi '^otpauth://' && has_otp=true

  printf '%s\n' "$rest" |
    grep -v -i '^otpauth://' |
    jq -Rn --argjson otp "$has_otp" '
      [inputs
       | select(test("^[A-Za-z0-9 _-]+[:=]"))
       | capture("^(?<key>[^:=]+)[:=]\\s*(?<value>.*)$")
       | {key: (.key | ascii_downcase | sub("^\\s+";"") | sub("\\s+$";"")), value: .value}
       | select(.value != "")]
      | {fields: ., otp: $otp}'
}

# The whole entry, password included. This is the editor's path: pass stores an
# entry as one blob, so rewriting one means having all of it, and reconstructing
# it from `fields` would silently drop the otpauth line and any free-form text.
cmd_body() {
  decrypt "$1"
}

# The password only. Deliberately separate from `fields` so a caller has to opt in.
cmd_reveal() {
  local body
  body=$(decrypt "$1")
  printf '%s\n' "${body%%$'\n'*}"
}

# --- secret extraction ------------------------------------------------------

# Pulls one value out of a decrypted entry. field="" means the password.
# The key is compared literally rather than as a regex, so a field name is
# never able to act as a pattern.
extract() {
  local body="$1" field="${2:-}"
  if [[ -z $field ]]; then
    printf '%s\n' "${body%%$'\n'*}"
    return
  fi
  printf '%s\n' "$body" | tail -n +2 | awk -v want="$field" '
    BEGIN { want = tolower(want) }
    {
      sep = index($0, ":")
      eq = index($0, "=")
      if (sep == 0 || (eq > 0 && eq < sep)) sep = eq
      if (sep == 0) next
      key = substr($0, 1, sep - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      if (tolower(key) != want) next
      value = substr($0, sep + 1)
      sub(/^[ \t]+/, "", value)
      print value
      exit
    }'
}

# The first field that exists, from a list of candidates. Used so "username"
# works whether the entry calls it login, user, username, or email.
extract_user() {
  local body="$1" value=""
  local candidate
  for candidate in login username user email account; do
    value=$(extract "$body" "$candidate")
    [[ -n $value ]] && { printf '%s\n' "$value"; return; }
  done
  return 1
}

# The URL of an entry, under any of the keys the editor recognises. Kept in
# step with parseBody() in PassStore.js on purpose: a key the editor files
# under "other lines" must not be the one this opens, or the two surfaces
# disagree about what the entry's URL is.
extract_url() {
  local body="$1" value=""
  local candidate
  for candidate in url site host; do
    value=$(extract "$body" "$candidate")
    [[ -n $value ]] && { printf '%s\n' "$value"; return; }
  done
  return 1
}

# --- clipboard --------------------------------------------------------------

# Copies with the sensitive hint set, so Omarchy's own clipboard manager (and
# any other well-behaved one) refuses to record it — capture.sh bails out on
# x-kde-passwordManagerHint. The offer is served by a detached wl-copy that
# `timeout` kills after CLIP_TIME, which drops the selection entirely rather
# than leaving a cleared-but-remembered entry behind.
copy_secret() {
  local secret="$1" label="${2:-Password}"
  [[ -n $secret ]] || die "nothing to copy"
  command -v wl-copy >/dev/null 2>&1 || die "wl-copy is not installed"

  printf '%s' "$secret" |
    setsid timeout "$CLIP_TIME" wl-copy --type text/plain --sensitive --foreground \
      >/dev/null 2>&1 &
  disown

  notify "$label copied" "Clipboard clears in ${CLIP_TIME}s"
}

# For things that are not secrets. No sensitive hint and no timeout: an entry
# name is meant to be pasted at leisure, and a clipboard that empties itself
# under you is only worth the annoyance when what it holds is a password.
copy_plain() {
  local value="$1" label="${2:-Text}"
  [[ -n $value ]] || die "nothing to copy"
  command -v wl-copy >/dev/null 2>&1 || die "wl-copy is not installed"
  printf '%s' "$value" | wl-copy --type text/plain >/dev/null 2>&1
  notify "$label copied" "$value"
}

# --- opening urls -----------------------------------------------------------

# Only an absolute URL with a scheme is ever handed on. Two reasons: the
# handler lookup is by scheme, so a bare "example.com" has nothing to dispatch
# on, and neither xdg-open nor omarchy-launch-browser takes a `--`, so a value
# starting with a dash would arrive as a flag. Requiring scheme:// also leaves
# javascript: and data: out without needing a list of everything to refuse.
validate_url() {
  local url="$1"
  [[ -n $url ]] || die "no url to open"
  [[ ${#url} -le 2048 ]] || die "that url is too long to open"
  LC_ALL=C grep -q '[[:cntrl:]]' <<<"$url" && die "that url has control characters"
  [[ $url =~ ^[A-Za-z][A-Za-z0-9+.-]*://[^[:space:]]+$ || $url =~ ^mailto:[^[:space:]]+$ ]] ||
    die "cannot open $url — a url needs a scheme, like https:// or ssh://"
}

# http and https go through omarchy's own launcher, which picks the default
# browser and then focuses the window it opened — worth having, and not worth
# reimplementing. Everything else (ssh, sftp, ftp, vnc, …) is what xdg-open is
# for. Detached either way: neither call should hold the plugin up.
open_url() {
  local url="$1"
  validate_url "$url"

  local opener=()
  if [[ $url == http://* || $url == https://* ]] && command -v omarchy-launch-browser >/dev/null 2>&1; then
    opener=(omarchy-launch-browser)
  elif command -v xdg-open >/dev/null 2>&1; then
    opener=(xdg-open)
  else
    die "no url handler installed (xdg-utils)"
  fi

  setsid "${opener[@]}" "$url" >/dev/null 2>&1 &
  disown

  notify "Opening" "$url" "󰖟"
}

# --- typing -----------------------------------------------------------------

type_secret() {
  local secret="$1"
  [[ -n $secret ]] || die "nothing to type"
  command -v wtype >/dev/null 2>&1 || die "wtype is not installed"
  # The overlay only closes as we start, so wait for focus to land back on the
  # window the user actually wants typed into.
  sleep "${OMAPASS_TYPE_FOCUS_DELAY:-$(config_number type-focus-delay 0.2)}"
  # --  stops wtype parsing a secret that starts with a dash as a flag.
  printf '%s' "$secret" | wtype -d "$TYPE_DELAY" -- -
}

# --- commands that touch secrets -------------------------------------------

cmd_copy() {
  local entry="$1" field="${2:-}" body secret
  body=$(decrypt "$entry")
  secret=$(extract "$body" "$field")
  copy_secret "$secret" "${field:-Password}"
}

cmd_copy_user() {
  local body secret
  body=$(decrypt "$1")
  secret=$(extract_user "$body") || die "no username field in $1"
  copy_secret "$secret" "Username"
}

# The entry's own name. Not a secret — this exists so a name that is a mail
# address or a hostname can be pasted into whatever asked for it.
cmd_copy_name() {
  local entry="$1"
  validate_entry "$entry"
  entry_exists "$entry" || die "no such entry: $entry"
  copy_plain "$entry" "Name"
}

# The URL is not a secret either, but reading it means decrypting the entry.
cmd_copy_url() {
  local body url
  body=$(decrypt "$1")
  url=$(extract_url "$body") || die "no url field in $1"
  copy_plain "$url" "URL"
}

# Opening a plain URL, for the parts of the UI that link somewhere fixed — the
# project homepage on the About screen. Same validation and same choice of
# handler as `open`, so there is one answer to "how does omapass open a link"
# rather than one per caller.
cmd_open_url() {
  open_url "$1"
}

cmd_open() {
  local body url
  body=$(decrypt "$1")
  url=$(extract_url "$body") || die "no url field in $1"
  open_url "$url"
}

cmd_type() {
  local entry="$1" field="${2:-}" body secret
  body=$(decrypt "$entry")
  secret=$(extract "$body" "$field")
  type_secret "$secret"
}

cmd_type_user() {
  local body secret
  body=$(decrypt "$1")
  secret=$(extract_user "$body") || die "no username field in $1"
  type_secret "$secret"
}

# username <Tab> password <Enter> — the usual "fill this login form" macro.
cmd_login() {
  local body user secret
  body=$(decrypt "$1")
  user=$(extract_user "$body") || die "no username field in $1"
  secret=$(extract "$body" "")
  type_secret "$user"
  wtype -k Tab
  type_secret "$secret"
  wtype -k Return
}

cmd_otp() {
  local entry="$1" action="${2:-copy}" code
  validate_entry "$entry"
  pass otp --help >/dev/null 2>&1 || die "pass-otp is not installed"
  code=$(pass otp -- "$entry" 2>/dev/null) || die "no OTP in $entry"
  case "$action" in
  copy) copy_secret "$code" "One-time code" ;;
  type) type_secret "$code" ;;
  *) die "unknown otp action: $action" ;;
  esac
}

# Reads a QR code off the screen and returns the otpauth:// URI it holds.
# Typing a TOTP secret by hand is miserable, and the code is always already on
# screen when you are enrolling.
scan_otp_uri() {
  has_or_die() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }
  has_or_die slurp
  has_or_die grim
  has_or_die zbarimg

  local region uri
  region=$(slurp -d 2>/dev/null) || die "no region selected"
  [[ -n $region ]] || die "no region selected"

  # Straight down the pipe: the QR image never touches disk.
  uri=$(grim -g "$region" - 2>/dev/null | zbarimg --quiet --raw - 2>/dev/null | head -n 1) || true
  uri=${uri%$'\n'}

  [[ -n $uri ]] || die "no QR code found in that region"
  [[ $uri == otpauth://* ]] || die "that QR code is not an otpauth:// URI"
  LC_ALL=C grep -q '[[:cntrl:]]' <<<"$uri" && die "that QR code contains control characters"

  printf '%s' "$uri"
}

cmd_otp_scan() {
  local entry="${1:-}" uri body rest

  uri=$(scan_otp_uri) || exit 1

  # No entry named: just hand the URI back, for the editor to drop in a field.
  if [[ -z $entry ]]; then
    printf '%s\n' "$uri"
    return
  fi

  require_pass
  validate_entry "$entry"
  entry_exists "$entry" || die "no such entry: $entry"

  body=$(decrypt "$entry")
  # Replace any existing otpauth line rather than stacking a second one.
  rest=$(printf '%s\n' "$body" | tail -n +2 | grep -v -i '^otpauth://' || true)
  {
    # The password keeps line 1 even when empty: dropping blank lines here
    # would promote the URI into the password position.
    printf '%s\n' "${body%%$'\n'*}"
    [[ -n $rest ]] && printf '%s\n' "$rest"
    printf '%s\n' "$uri"
  } | pass insert -m -f -- "$entry" >/dev/null

  notify "One-time code added" "$entry" "󰯄"
}

# --- mutations --------------------------------------------------------------

# Same character set pass(1) generates from, so entries made here and entries
# made with `pass generate` are indistinguishable.
gen_password() {
  local length="$1" symbols="$2" charset='[:alnum:]' out=""
  [[ $symbols == "no" ]] || charset='[:punct:][:alnum:]'
  # Oversample, because most random bytes fall outside the character set. The
  # loop covers the unlucky draw where one pass still comes up short.
  while [[ ${#out} -lt $length ]]; do
    out+=$(LC_ALL=C head -c $((length * 8)) /dev/urandom | tr -dc "$charset")
  done
  printf '%s' "${out:0:length}"
}

# Reads the whole entry body (password on line 1, fields after) from stdin, so
# the password never lands in argv.
#
# With --generate, line 1 of the body is discarded and replaced with a fresh
# password. Going through the same write path as a normal save is what keeps
# the other lines — username, url, otp — intact when you regenerate, which
# `pass generate` on its own would throw away.
cmd_insert() {
  local entry="$1" generate="no" length=24 symbols="yes" force="no"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --generate)
      generate="yes"
      length="${2:-24}"
      symbols="${3:-yes}"
      shift 3 || shift $#
      ;;
    # Replacing an entry is only ever right when the caller knows one is there
    # — editing it. Creating one is not, so the default refuses.
    --force)
      force="yes"
      shift
      ;;
    *) die "unknown insert option: $1" ;;
    esac
  done

  require_pass
  validate_entry "$entry"

  if [[ $force == "no" ]] && entry_exists "$entry"; then
    die "$entry already exists — edit it, or choose another name"
  fi
  [[ $length =~ ^[0-9]+$ ]] || die "length must be a number"

  local body password rest
  body=$(cat)

  if [[ $generate == "yes" ]]; then
    password=$(gen_password "$length" "$symbols")
    [[ ${#password} -eq $length ]] || die "could not generate a password"
    rest=$(printf '%s\n' "$body" | tail -n +2)
    body=$(printf '%s\n%s' "$password" "$rest")
  fi

  printf '%s\n' "$body" | pass insert -m -f -- "$entry" >/dev/null

  if [[ $generate == "yes" ]]; then
    notify "Generated" "$entry" "󰌆"
    copy_secret "$password" "Password"
  else
    notify "Saved" "$entry" "󰆓"
  fi
}

# Convenience wrapper for the command line; the overlay uses `insert --generate`
# so that it can carry the other fields through in the same write.
cmd_generate() {
  local entry="$1" length="${2:-24}" symbols="${3:-yes}" rest=""
  require_pass
  validate_entry "$entry"

  # Keep whatever else the entry already held.
  if entry_exists "$entry"; then
    rest=$(pass show -- "$entry" 2>/dev/null | tail -n +2) || rest=""
  fi

  printf 'placeholder\n%s\n' "$rest" | cmd_insert "$entry" --generate "$length" "$symbols" --force
}

cmd_rename() {
  require_pass
  validate_entry "$1"
  validate_entry "$2"
  entry_exists "$1" || die "no such entry: $1"
  # -f below is what lets pass overwrite; without this check a rename would
  # quietly destroy whatever was already sitting at the destination.
  entry_exists "$2" && die "$2 already exists — choose another name"
  pass mv -f -- "$1" "$2" >/dev/null 2>&1 || die "could not rename $1"
  notify "Renamed" "$1 → $2" "󰑕"
}

cmd_remove() {
  require_pass
  validate_entry "$1"
  entry_exists "$1" || die "no such entry: $1"
  pass rm -r -f -- "$1" >/dev/null 2>&1 || die "could not remove $1"
  notify "Deleted" "$1" "󰩹"
}

cmd_sync() {
  require_pass
  [[ -d $STORE/.git ]] || die "password store is not a git repository"
  pass git pull --rebase --quiet 2>/dev/null || die "pull failed"
  pass git push --quiet 2>/dev/null || die "push failed"
  notify "Store synced" "" "󰊢"
}

# --- entry point ------------------------------------------------------------

usage() {
  cat <<'USAGE'
omapass — pass(1) backend for the omapass Omarchy plugin

  version                    print the omapass version
  log [--path|--clear|--event <text>]
                             debug log location, clear it, or append a line
  quit                       stop the plugin; it stays installed
  doctor                     which copy is running, and is logging on
  welcomed [--mark|--reset]  whether the welcome screen has been shown
  status                     JSON: what is installed and set up
  unlocked                   JSON: whether gpg-agent has a key cached
  fingerprint                JSON: whether fingerprint unlock is required
  config [--path|--init]     effective configuration as JSON; --init writes a
                             commented template to the config file
  list                       JSON: every entry in the store
  fields <entry>             JSON: non-password fields (never the password)
  reveal <entry>             print the password to stdout
  body <entry>               print the whole entry (the editor's read path)
  copy <entry> [field]       copy password (or field) to the clipboard
  copy-user <entry>          copy the username field
  copy-name <entry>          copy the entry's own name
  copy-url <entry>           copy the url field
  open <entry>               open the url field with the desktop's handler
  open-url <url>             open a url with the desktop's handler
  type <entry> [field]       type password (or field) into the focused window
  type-user <entry>          type the username field
  login <entry>              type username, Tab, password, Enter
  otp <entry> [copy|type]    one-time code, via pass-otp
  otp-scan [entry]           read a QR code off the screen; store it in <entry>,
                             or print the otpauth:// URI when given no entry
  insert <entry> [--generate <len> <yes|no>] [--force]
                             create an entry, body read from stdin; refuses to
                             replace an existing one unless --force
  generate <entry> [len] [yes|no]   generate a password (symbols yes/no)
  rename <old> <new>
  remove <entry>
  sync                       git pull --rebase && git push
USAGE
}

# Recorded through an EXIT trap rather than around the call. Wrapping dispatch
# in `|| status=$?` looked tidier but put every command inside a `||` list,
# which switches `set -e` off for the whole of it — failures stopped aborting
# and started returning 0. The trap sees the real exit status and leaves
# errexit alone.
LOG_CMD=""
LOG_ARGS=()
LOG_START=0
MAIN_PID=$$

now_ms() { date +%s%3N 2>/dev/null || echo 0; }

# Command substitution subshells inherit the EXIT trap, so without the PID
# guard a `body=$(decrypt ...)` that fails would log a line of its own.
log_finish() {
  local status=$?
  [[ $BASHPID == "$MAIN_PID" ]] || return 0
  # `log` writes the file; a line about having written it is pure noise.
  [[ $LOG_CMD != "log" ]] || return 0
  log_line "$(printf '%-10s exit=%s entry=%s dur=%sms' \
    "$LOG_CMD" "$status" "$(log_digest "${LOG_ARGS[0]:-}")" "$(($(now_ms) - LOG_START))")"
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  LOG_CMD="$cmd"
  LOG_ARGS=("$@")
  case "$cmd" in
  copy | copy-user | copy-name | copy-url | type | type-user | login | otp | otp-scan | open | open-url | sync)
    NOTIFY_ERRORS=true
    ;;
  esac
  LOG_START=$(now_ms)
  trap log_finish EXIT

  dispatch "$cmd" "$@"
}

dispatch() {
  local cmd="$1"; shift

  case "$cmd" in
  version | --version | -V) printf 'omapass %s\n' "$(omapass_version)" ;;
  welcomed) cmd_welcomed "${1:-}" ;;
  status) cmd_status ;;
  config) cmd_config "${1:-}" ;;
  log) cmd_log "$@" ;;
  quit) cmd_quit ;;
  doctor) cmd_doctor ;;
  fingerprint) fingerprint_available && echo '{"fingerprint":true}' || echo '{"fingerprint":false}' ;;
  unlocked) cmd_unlocked ;;
  list) cmd_list ;;
  fields) cmd_fields "${1:?entry required}" ;;
  reveal) cmd_reveal "${1:?entry required}" ;;
  body) cmd_body "${1:?entry required}" ;;
  copy) cmd_copy "${1:?entry required}" "${2:-}" ;;
  copy-user) cmd_copy_user "${1:?entry required}" ;;
  copy-name) cmd_copy_name "${1:?entry required}" ;;
  copy-url) cmd_copy_url "${1:?entry required}" ;;
  open) cmd_open "${1:?entry required}" ;;
  open-url) cmd_open_url "${1:?url required}" ;;
  type) cmd_type "${1:?entry required}" "${2:-}" ;;
  type-user) cmd_type_user "${1:?entry required}" ;;
  login) cmd_login "${1:?entry required}" ;;
  otp) cmd_otp "${1:?entry required}" "${2:-copy}" ;;
  otp-scan) cmd_otp_scan "${1:-}" ;;
  insert) cmd_insert "${1:?entry required}" "${@:2}" ;;
  generate) cmd_generate "${1:?entry required}" "${2:-24}" "${3:-yes}" ;;
  rename) cmd_rename "${1:?old required}" "${2:?new required}" ;;
  remove) cmd_remove "${1:?entry required}" ;;
  sync) cmd_sync ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
