#!/bin/bash

# omapass — pass(1) backend for the omapass Omarchy shell plugin.
#
# The shell plugin never handles a decrypted password itself: every action that
# touches a secret happens in here, and the secret goes straight from gpg to the
# clipboard or to wtype. The only exception is `reveal`, which the user has to
# ask for explicitly.
#
# Secrets are passed between functions in bash variables, never in argv, so they
# never appear in /proc/*/cmdline.

set -euo pipefail

# Config, shared with the other scripts in bin/.
OMAPASS_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck source=../lib/config.sh
source "$OMAPASS_LIB/config.sh"

die() {
  echo "omapass: $*" >&2
  exit 1
}

notify() {
  local title="$1" body="${2:-}" glyph="${3:-󰌾}"
  command -v omarchy-notification-send >/dev/null 2>&1 || return 0
  omarchy-notification-send --app-name omapass -g "$glyph" -t 3000 "$title" "$body" >/dev/null 2>&1 || true
}

require_pass() {
  command -v pass >/dev/null 2>&1 || die "pass is not installed"
  [[ -d $STORE ]] || die "no password store at $STORE"
}

# Reject anything that could climb out of the store or hit a shell.
validate_entry() {
  local entry="$1"
  [[ -n $entry ]] || die "empty entry name"
  [[ $entry != /* ]] || die "entry must be relative: $entry"
  [[ $entry != *..* ]] || die "entry may not contain '..': $entry"
  [[ $entry != *$'\n'* ]] || die "entry may not contain newlines"
  # A leading dash makes pass read the name as an option. The read paths happen
  # to be covered by the file-existence check, but insert/generate/mv have no
  # such guard, so reject it here and terminate options at every call site too.
  [[ $entry != -* ]] || die "entry may not start with '-': $entry"
}

entry_exists() {
  [[ -f "$STORE/$1.gpg" ]]
}

# --- JSON helpers -----------------------------------------------------------

# `status` is the one command that has to work when the dependencies do not,
# since reporting a missing jq through jq would be a poor joke. Everything it
# emits is hand-rolled; the commands that genuinely need jq say so.

# The values actually in force, after file, environment and defaults have been
# resolved. The UI reads this rather than parsing the file itself.
config_json() {
  printf '{"path":"%s","exists":%s,' \
    "$(json_escape "$CONFIG_FILE")" \
    "$([[ -r $CONFIG_FILE ]] && echo true || echo false)"
  printf '"store":"%s","clipTime":%s,"typeDelay":%s,"typeFocusDelay":%s,' \
    "$(json_escape "$STORE")" \
    "$CLIP_TIME" "$TYPE_DELAY" \
    "${OMAPASS_TYPE_FOCUS_DELAY:-$(config_number type-focus-delay 0.2)}"
  printf '"revealTimeout":%s,"fingerprint":"%s","fingerprintGrace":%s,"pulldownRows":%s,' \
    "$(config_number reveal-timeout 15)" \
    "$(json_escape "${CONFIG[fingerprint]}")" \
    "$(config_number fingerprint-grace 120)" \
    "$(config_number pulldown-rows 7)"
  printf '"backupDir":"%s","keybind":"%s"}' \
    "$(json_escape "$BACKUP_DIR")" \
    "$(json_escape "${OMAPASS_KEYBIND:-${CONFIG[keybind]}}")"
}

cmd_config() {
  case "${1:-}" in
  --path) printf '%s\n' "$CONFIG_FILE" ;;
  --init) write_config_template ;;
  "") config_json; echo ;;
  *) die "unknown config option: $1" ;;
  esac
}

write_config_template() {
  if [[ -e $CONFIG_FILE ]]; then
    echo "omapass: $CONFIG_FILE already exists, leaving it alone" >&2
    return 1
  fi
  mkdir -p "$(dirname "$CONFIG_FILE")"
  cat >"$CONFIG_FILE" <<'TEMPLATE'
# omapass configuration
#
# Every setting is commented out at its default. Uncomment to change one.
# An environment variable of the same name still wins over this file, so a
# one-off run can override without editing anything.

# Where the password store lives. ~ is expanded.
# store = ~/.password-store

# Seconds a copied password stays on the clipboard before it is dropped.
# clip-time = 45

# Milliseconds between simulated keystrokes when typing into a window.
# type-delay = 12

# Seconds to wait for focus to land back on the target window before typing.
# Raise this if the first characters of a typed password go missing.
# type-focus-delay = 0.2

# Seconds a revealed password stays on screen before it re-hides.
# reveal-timeout = 15

# Fingerprint unlock in front of the vault.
#   auto    require it when a finger is enrolled  (default)
#   always  require it whenever the PAM service exists, even if enrolment
#           cannot be confirmed
#   off     never require it
# Esc and the pass CLI always get you past the prompt, whatever this says.
# fingerprint = auto

# Seconds a successful fingerprint scan stays valid before it is asked for again.
# fingerprint-grace = 120

# Rows shown in the bar pulldown. A per-widget setting in shell.json,
# if you have one, wins over this.
# pulldown-rows = 7

# Where omapass-reset writes its backups.
# backup-dir = ~/.local/state/omapass/backups

# The hotkey install.sh binds to open the overlay, in Hyprland's own syntax:
# modifiers, then the key. Re-run ./install.sh after changing it — the old
# binding is replaced, not duplicated.
#
# SUPER + CTRL + K is NOT a good choice: Omarchy already uses it.
# keybind = SUPER SHIFT, K
TEMPLATE
  echo "omapass: wrote $CONFIG_FILE"
}

# --- requirements -----------------------------------------------------------

# Everything omapass needs at runtime, in the order a person would fix them.
# `hint` is the exact command to run, so the overlay can show instructions
# rather than just a red cross.
req_row() {
  local key="$1" label="$2" hint="$3" optional="$4" ok="$5"
  printf '{"key":"%s","label":"%s","hint":"%s","optional":%s,"ok":%s}' \
    "$(json_escape "$key")" "$(json_escape "$label")" "$(json_escape "$hint")" \
    "$optional" "$ok"
}

have() { command -v "$1" >/dev/null 2>&1 && printf 'true' || printf 'false'; }

secret_key_lines() {
  gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '
    $1 == "sec" { fpr = ""; uid = "" }
    $1 == "fpr" && fpr == "" { fpr = $10 }
    $1 == "uid" && uid == "" && fpr != "" { uid = $10; print fpr "\t" uid; fpr = "" }
  '
}

# Fingerprint unlock, detected exactly the way Omarchy's own lock screen does:
# the PAM service has to exist and a finger has to actually be enrolled.
# Touching a reader that has nothing enrolled would lock the user out of their
# own vault, so both halves are required.
fingerprint_available() {
  local mode="${CONFIG[fingerprint]}"

  # The marker file predates the config setting and still works, because it is
  # the easiest thing to create when a reader is refusing you entry.
  [[ ! -e ${XDG_CONFIG_HOME:-$HOME/.config}/omapass/no-fingerprint ]] || return 1

  case "$mode" in
  off) return 1 ;;
  auto | always) ;;
  *)
    config_warn "fingerprint: '$mode' is not auto, always or off — using auto"
    mode="auto"
    ;;
  esac

  [[ -f /etc/pam.d/omarchy-lock-fingerprint ]] || return 1

  # `always` trusts the PAM service alone, for readers fprintd-list does not
  # report cleanly. Esc and the pass CLI still get you past it.
  [[ $mode == "always" ]] && return 0

  command -v fprintd-list >/dev/null 2>&1 || return 1
  fprintd-list "$USER" 2>/dev/null | grep -qi finger || return 1
  return 0
}

cmd_status() {
  local has_pass has_gpg has_wlcopy has_wtype has_jq has_otp=false
  has_pass=$(have pass)
  has_gpg=$(have gpg)
  has_wlcopy=$(have wl-copy)
  has_wtype=$(have wtype)
  has_jq=$(have jq)
  [[ $has_pass == "true" ]] && pass otp --help >/dev/null 2>&1 && has_otp=true

  local keys_raw has_key=false
  keys_raw=$(secret_key_lines)
  [[ -n $keys_raw ]] && has_key=true

  local has_fingerprint=false
  fingerprint_available && has_fingerprint=true

  local has_store=false has_git=false entries=0
  [[ -f $STORE/.gpg-id ]] && has_store=true
  [[ -d $STORE/.git ]] && has_git=true
  if [[ $has_store == "true" ]]; then
    entries=$(find "$STORE" -name '*.gpg' -type f -not -path '*/.git/*' 2>/dev/null | wc -l)
  fi

  # The key id makes the store hint copy-pasteable instead of a placeholder.
  local key_hint="pass init <your-key-id>"
  if [[ $has_key == "true" ]]; then
    key_hint="pass init $(head -n1 <<<"$keys_raw" | cut -f1)"
  fi

  local rows=()
  rows+=("$(req_row pass       "pass CLI"                   "sudo pacman -S --needed pass"          false "$has_pass")")
  rows+=("$(req_row gpg        "GnuPG"                      "sudo pacman -S --needed gnupg"         false "$has_gpg")")
  rows+=("$(req_row wl-copy    "wl-clipboard (copying)"     "sudo pacman -S --needed wl-clipboard"  false "$has_wlcopy")")
  rows+=("$(req_row wtype      "wtype (typing into windows)" "sudo pacman -S --needed wtype"        false "$has_wtype")")
  rows+=("$(req_row jq         "jq"                         "sudo pacman -S --needed jq"            false "$has_jq")")
  rows+=("$(req_row key        "GPG key"                    "gpg --full-generate-key"               false "$has_key")")
  rows+=("$(req_row store      "Password store"             "$key_hint"                             false "$has_store")")
  rows+=("$(req_row pass-otp   "pass-otp (one-time codes)"  "sudo pacman -S --needed pass-otp"      true  "$has_otp")")

  local ready=true
  [[ $has_pass == "true" && $has_gpg == "true" && $has_wlcopy == "true" \
     && $has_wtype == "true" && $has_jq == "true" && $has_key == "true" \
     && $has_store == "true" ]] || ready=false

  local requirements
  requirements=$(IFS=,; printf '%s' "${rows[*]}")

  local keys="" sep=""
  while IFS=$'\t' read -r fpr uid; do
    [[ -n $fpr ]] || continue
    keys+="$sep{\"id\":\"$(json_escape "$fpr")\",\"uid\":\"$(json_escape "$uid")\"}"
    sep=","
  done <<<"$keys_raw"

  printf '{"version":"%s","pass":%s,"otp":%s,"gpg":%s,"key":%s,"store":%s,"git":%s,"fingerprint":%s,' \
    "$(json_escape "$(omapass_version)")" \
    "$has_pass" "$has_otp" "$has_gpg" "$has_key" "$has_store" "$has_git" "$has_fingerprint"
  printf '"entries":%s,"storePath":"%s","keys":[%s],' \
    "$entries" "$(json_escape "$STORE")" "$keys"
  printf '"requirements":[%s],"config":%s,"ready":%s}\n' \
    "$requirements" "$(config_json)" "$ready"
}

# Whether gpg-agent still holds a key, i.e. whether decrypting right now would
# raise a pinentry prompt. Best-effort: false is always the safe answer, and the
# detail pane simply stays closed until the user asks for it.
cmd_unlocked() {
  local cached=false out
  out=$(gpg-connect-agent 'keyinfo --list' /bye 2>/dev/null) || true
  if awk '$1 == "S" && $2 == "KEYINFO" && $7 == "1" { found = 1 } END { exit !found }' <<<"$out"; then
    cached=true
  fi
  printf '{"unlocked":%s}\n' "$cached"
}

# --- list -------------------------------------------------------------------

cmd_list() {
  require_pass
  find "$STORE" -name '*.gpg' -type f -not -path '*/.git/*' -printf '%P\n' 2>/dev/null |
    sed 's/\.gpg$//' |
    LC_ALL=C sort |
    jq -Rn '[inputs | select(length > 0) | {
      path: .,
      name: (split("/") | last),
      folder: (if (index("/")) then (split("/")[:-1] | join("/")) else "" end)
    }]'
}

# --- decrypt ----------------------------------------------------------------

# Echoes the full decrypted entry. Callers must keep it in a variable.
decrypt() {
  local entry="$1"
  validate_entry "$entry"
  entry_exists "$entry" || die "no such entry: $entry"
  pass show -- "$entry" 2>/dev/null || die "could not decrypt $entry"
}

# Everything after the first line, as key: value pairs. The password line is
# dropped before anything is printed, so it cannot leak into the shell process.
cmd_fields() {
  local entry="$1" body rest
  body=$(decrypt "$entry")
  rest=$(printf '%s\n' "$body" | tail -n +2)

  local has_otp=false
  printf '%s\n' "$rest" | grep -qi '^otpauth://' && has_otp=true

  printf '%s\n' "$rest" |
    grep -v -i '^otpauth://' |
    jq -Rn --argjson otp "$has_otp" '
      [inputs
       | select(test("^[A-Za-z0-9 _-]+[:=]"))
       | capture("^(?<key>[^:=]+)[:=]\\s*(?<value>.*)$")
       | {key: (.key | ascii_downcase | sub("^\\s+";"") | sub("\\s+$";"")), value: .value}
       | select(.value != "")]
      | {fields: ., otp: $otp}'
}

# The whole entry, password included. This is the editor's path: pass stores an
# entry as one blob, so rewriting one means having all of it, and reconstructing
# it from `fields` would silently drop the otpauth line and any free-form text.
cmd_body() {
  decrypt "$1"
}

# The password only. Deliberately separate from `fields` so a caller has to opt in.
cmd_reveal() {
  local body
  body=$(decrypt "$1")
  printf '%s\n' "${body%%$'\n'*}"
}

# --- secret extraction ------------------------------------------------------

# Pulls one value out of a decrypted entry. field="" means the password.
# The key is compared literally rather than as a regex, so a field name is
# never able to act as a pattern.
extract() {
  local body="$1" field="${2:-}"
  if [[ -z $field ]]; then
    printf '%s\n' "${body%%$'\n'*}"
    return
  fi
  printf '%s\n' "$body" | tail -n +2 | awk -v want="$field" '
    BEGIN { want = tolower(want) }
    {
      sep = index($0, ":")
      eq = index($0, "=")
      if (sep == 0 || (eq > 0 && eq < sep)) sep = eq
      if (sep == 0) next
      key = substr($0, 1, sep - 1)
      gsub(/^[ \t]+|[ \t]+$/, "", key)
      if (tolower(key) != want) next
      value = substr($0, sep + 1)
      sub(/^[ \t]+/, "", value)
      print value
      exit
    }'
}

# The first field that exists, from a list of candidates. Used so "username"
# works whether the entry calls it login, user, username, or email.
extract_user() {
  local body="$1" value=""
  local candidate
  for candidate in login username user email account; do
    value=$(extract "$body" "$candidate")
    [[ -n $value ]] && { printf '%s\n' "$value"; return; }
  done
  return 1
}

# --- clipboard --------------------------------------------------------------

# Copies with the sensitive hint set, so Omarchy's own clipboard manager (and
# any other well-behaved one) refuses to record it — capture.sh bails out on
# x-kde-passwordManagerHint. The offer is served by a detached wl-copy that
# `timeout` kills after CLIP_TIME, which drops the selection entirely rather
# than leaving a cleared-but-remembered entry behind.
copy_secret() {
  local secret="$1" label="${2:-Password}"
  [[ -n $secret ]] || die "nothing to copy"
  command -v wl-copy >/dev/null 2>&1 || die "wl-copy is not installed"

  printf '%s' "$secret" |
    setsid timeout "$CLIP_TIME" wl-copy --type text/plain --sensitive --foreground \
      >/dev/null 2>&1 &
  disown

  notify "$label copied" "Clipboard clears in ${CLIP_TIME}s"
}

# --- typing -----------------------------------------------------------------

type_secret() {
  local secret="$1"
  [[ -n $secret ]] || die "nothing to type"
  command -v wtype >/dev/null 2>&1 || die "wtype is not installed"
  # The overlay only closes as we start, so wait for focus to land back on the
  # window the user actually wants typed into.
  sleep "${OMAPASS_TYPE_FOCUS_DELAY:-$(config_number type-focus-delay 0.2)}"
  # --  stops wtype parsing a secret that starts with a dash as a flag.
  printf '%s' "$secret" | wtype -d "$TYPE_DELAY" -- -
}

# --- commands that touch secrets -------------------------------------------

cmd_copy() {
  local entry="$1" field="${2:-}" body secret
  body=$(decrypt "$entry")
  secret=$(extract "$body" "$field")
  copy_secret "$secret" "${field:-Password}"
}

cmd_copy_user() {
  local body secret
  body=$(decrypt "$1")
  secret=$(extract_user "$body") || die "no username field in $1"
  copy_secret "$secret" "Username"
}

cmd_type() {
  local entry="$1" field="${2:-}" body secret
  body=$(decrypt "$entry")
  secret=$(extract "$body" "$field")
  type_secret "$secret"
}

cmd_type_user() {
  local body secret
  body=$(decrypt "$1")
  secret=$(extract_user "$body") || die "no username field in $1"
  type_secret "$secret"
}

# username <Tab> password <Enter> — the usual "fill this login form" macro.
cmd_login() {
  local body user secret
  body=$(decrypt "$1")
  user=$(extract_user "$body") || die "no username field in $1"
  secret=$(extract "$body" "")
  type_secret "$user"
  wtype -k Tab
  type_secret "$secret"
  wtype -k Return
}

cmd_otp() {
  local entry="$1" action="${2:-copy}" code
  validate_entry "$entry"
  pass otp --help >/dev/null 2>&1 || die "pass-otp is not installed"
  code=$(pass otp -- "$entry" 2>/dev/null) || die "no OTP in $entry"
  case "$action" in
  copy) copy_secret "$code" "One-time code" ;;
  type) type_secret "$code" ;;
  *) die "unknown otp action: $action" ;;
  esac
}

# Reads a QR code off the screen and returns the otpauth:// URI it holds.
# Typing a TOTP secret by hand is miserable, and the code is always already on
# screen when you are enrolling.
scan_otp_uri() {
  has_or_die() { command -v "$1" >/dev/null 2>&1 || die "$1 is not installed"; }
  has_or_die slurp
  has_or_die grim
  has_or_die zbarimg

  local region uri
  region=$(slurp -d 2>/dev/null) || die "no region selected"
  [[ -n $region ]] || die "no region selected"

  # Straight down the pipe: the QR image never touches disk.
  uri=$(grim -g "$region" - 2>/dev/null | zbarimg --quiet --raw - 2>/dev/null | head -n 1) || true
  uri=${uri%$'\n'}

  [[ -n $uri ]] || die "no QR code found in that region"
  [[ $uri == otpauth://* ]] || die "that QR code is not an otpauth:// URI"

  printf '%s' "$uri"
}

cmd_otp_scan() {
  local entry="${1:-}" uri body rest

  uri=$(scan_otp_uri) || exit 1

  # No entry named: just hand the URI back, for the editor to drop in a field.
  if [[ -z $entry ]]; then
    printf '%s\n' "$uri"
    return
  fi

  require_pass
  validate_entry "$entry"
  entry_exists "$entry" || die "no such entry: $entry"

  body=$(decrypt "$entry")
  # Replace any existing otpauth line rather than stacking a second one.
  rest=$(printf '%s\n' "$body" | tail -n +2 | grep -v -i '^otpauth://' || true)
  {
    # The password keeps line 1 even when empty: dropping blank lines here
    # would promote the URI into the password position.
    printf '%s\n' "${body%%$'\n'*}"
    [[ -n $rest ]] && printf '%s\n' "$rest"
    printf '%s\n' "$uri"
  } | pass insert -m -f -- "$entry" >/dev/null

  notify "One-time code added" "$entry" "󰯄"
}

# --- mutations --------------------------------------------------------------

# Same character set pass(1) generates from, so entries made here and entries
# made with `pass generate` are indistinguishable.
gen_password() {
  local length="$1" symbols="$2" charset='[:alnum:]' out=""
  [[ $symbols == "no" ]] || charset='[:punct:][:alnum:]'
  # Oversample, because most random bytes fall outside the character set. The
  # loop covers the unlucky draw where one pass still comes up short.
  while [[ ${#out} -lt $length ]]; do
    out+=$(LC_ALL=C head -c $((length * 8)) /dev/urandom | tr -dc "$charset")
  done
  printf '%s' "${out:0:length}"
}

# Reads the whole entry body (password on line 1, fields after) from stdin, so
# the password never lands in argv.
#
# With --generate, line 1 of the body is discarded and replaced with a fresh
# password. Going through the same write path as a normal save is what keeps
# the other lines — username, url, otp — intact when you regenerate, which
# `pass generate` on its own would throw away.
cmd_insert() {
  local entry="$1" generate="no" length=24 symbols="yes"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --generate)
      generate="yes"
      length="${2:-24}"
      symbols="${3:-yes}"
      shift 3 || shift $#
      ;;
    *) die "unknown insert option: $1" ;;
    esac
  done

  require_pass
  validate_entry "$entry"
  [[ $length =~ ^[0-9]+$ ]] || die "length must be a number"

  local body password rest
  body=$(cat)

  if [[ $generate == "yes" ]]; then
    password=$(gen_password "$length" "$symbols")
    [[ ${#password} -eq $length ]] || die "could not generate a password"
    rest=$(printf '%s\n' "$body" | tail -n +2)
    body=$(printf '%s\n%s' "$password" "$rest")
  fi

  printf '%s\n' "$body" | pass insert -m -f -- "$entry" >/dev/null

  if [[ $generate == "yes" ]]; then
    notify "Generated" "$entry" "󰌆"
    copy_secret "$password" "Password"
  else
    notify "Saved" "$entry" "󰆓"
  fi
}

# Convenience wrapper for the command line; the overlay uses `insert --generate`
# so that it can carry the other fields through in the same write.
cmd_generate() {
  local entry="$1" length="${2:-24}" symbols="${3:-yes}" rest=""
  require_pass
  validate_entry "$entry"

  # Keep whatever else the entry already held.
  if entry_exists "$entry"; then
    rest=$(pass show -- "$entry" 2>/dev/null | tail -n +2) || rest=""
  fi

  printf 'placeholder\n%s\n' "$rest" | cmd_insert "$entry" --generate "$length" "$symbols"
}

cmd_rename() {
  require_pass
  validate_entry "$1"
  validate_entry "$2"
  entry_exists "$1" || die "no such entry: $1"
  pass mv -f -- "$1" "$2" >/dev/null 2>&1 || die "could not rename $1"
  notify "Renamed" "$1 → $2" "󰑕"
}

cmd_remove() {
  require_pass
  validate_entry "$1"
  entry_exists "$1" || die "no such entry: $1"
  pass rm -r -f -- "$1" >/dev/null 2>&1 || die "could not remove $1"
  notify "Deleted" "$1" "󰩹"
}

cmd_sync() {
  require_pass
  [[ -d $STORE/.git ]] || die "password store is not a git repository"
  pass git pull --rebase --quiet 2>/dev/null || die "pull failed"
  pass git push --quiet 2>/dev/null || die "push failed"
  notify "Store synced" "" "󰊢"
}

# --- entry point ------------------------------------------------------------

usage() {
  cat <<'USAGE'
omapass — pass(1) backend for the omapass Omarchy plugin

  version                    print the omapass version
  status                     JSON: what is installed and set up
  unlocked                   JSON: whether gpg-agent has a key cached
  fingerprint                JSON: whether fingerprint unlock is required
  config [--path|--init]     effective configuration as JSON; --init writes a
                             commented template to the config file
  list                       JSON: every entry in the store
  fields <entry>             JSON: non-password fields (never the password)
  reveal <entry>             print the password to stdout
  body <entry>               print the whole entry (the editor's read path)
  copy <entry> [field]       copy password (or field) to the clipboard
  copy-user <entry>          copy the username field
  type <entry> [field]       type password (or field) into the focused window
  type-user <entry>          type the username field
  login <entry>              type username, Tab, password, Enter
  otp <entry> [copy|type]    one-time code, via pass-otp
  otp-scan [entry]           read a QR code off the screen; store it in <entry>,
                             or print the otpauth:// URI when given no entry
  insert <entry> [--generate <len> <yes|no>]
                             create/replace an entry, body read from stdin
  generate <entry> [len] [yes|no]   generate a password (symbols yes/no)
  rename <old> <new>
  remove <entry>
  sync                       git pull --rebase && git push
USAGE
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true

  case "$cmd" in
  version | --version | -V) printf 'omapass %s\n' "$(omapass_version)" ;;
  status) cmd_status ;;
  config) cmd_config "${1:-}" ;;
  fingerprint) fingerprint_available && echo '{"fingerprint":true}' || echo '{"fingerprint":false}' ;;
  unlocked) cmd_unlocked ;;
  list) cmd_list ;;
  fields) cmd_fields "${1:?entry required}" ;;
  reveal) cmd_reveal "${1:?entry required}" ;;
  body) cmd_body "${1:?entry required}" ;;
  copy) cmd_copy "${1:?entry required}" "${2:-}" ;;
  copy-user) cmd_copy_user "${1:?entry required}" ;;
  type) cmd_type "${1:?entry required}" "${2:-}" ;;
  type-user) cmd_type_user "${1:?entry required}" ;;
  login) cmd_login "${1:?entry required}" ;;
  otp) cmd_otp "${1:?entry required}" "${2:-copy}" ;;
  otp-scan) cmd_otp_scan "${1:-}" ;;
  insert) cmd_insert "${1:?entry required}" "${@:2}" ;;
  generate) cmd_generate "${1:?entry required}" "${2:-24}" "${3:-yes}" ;;
  rename) cmd_rename "${1:?old required}" "${2:?new required}" ;;
  remove) cmd_remove "${1:?entry required}" ;;
  sync) cmd_sync ;;
  -h | --help | help | "") usage ;;
  *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
