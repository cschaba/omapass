#!/bin/bash

# omapass-setup — guided first-run setup, run in a terminal.
#
# The overlay shells out to this instead of doing the work itself: installing
# packages needs sudo and generating a key needs a real pinentry prompt, neither
# of which belongs inside the Quickshell process.

set -uo pipefail

STORE="${PASSWORD_STORE_DIR:-$HOME/.password-store}"

has() { command -v "$1" >/dev/null 2>&1; }

heading() { gum style --bold --foreground 4 "$*"; }
ok() { gum style --foreground 2 "  ✓ $*"; }
warn() { gum style --foreground 3 "  ! $*"; }
fail() { gum style --foreground 1 "  ✗ $*"; }

confirm() { gum confirm "$1" && return 0 || return 1; }

# --- 1. pass ----------------------------------------------------------------

install_pass() {
  heading "1/4  The pass CLI"

  if has pass; then
    ok "pass $(pass version 2>/dev/null | grep -oP 'v\K[0-9.]+' | head -1)"
  else
    warn "pass is not installed"
    confirm "Install pass now?" || return 1
    sudo pacman -S --needed --noconfirm pass || return 1
    ok "pass installed"
  fi

  if pass otp --help >/dev/null 2>&1; then
    ok "pass-otp (one-time codes)"
  else
    if confirm "Install pass-otp too, for TOTP codes?"; then
      sudo pacman -S --needed --noconfirm pass-otp && ok "pass-otp installed"
    else
      warn "skipping pass-otp — OTP actions will stay hidden"
    fi
  fi
  echo
}

# --- 2. gpg key -------------------------------------------------------------

secret_keys() {
  gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '
    $1 == "sec" { fpr = "" }
    $1 == "fpr" && fpr == "" { fpr = $10 }
    $1 == "uid" && fpr != "" { print fpr "\t" $10; fpr = "" }
  '
}

setup_key() {
  heading "2/4  GPG key"

  local keys
  keys=$(secret_keys)

  if [[ -n $keys ]]; then
    ok "$(wc -l <<<"$keys") secret key(s) already available"
    echo
    return 0
  fi

  warn "no GPG secret key — pass encrypts to one, so we need it"
  confirm "Generate a key now?" || return 1

  local name email
  name=$(gum input --prompt "Real name > " --value "$(getent passwd "$USER" | cut -d: -f5 | cut -d, -f1)")
  [[ -n $name ]] || { fail "a name is required"; return 1; }
  email=$(gum input --prompt "Email > " --placeholder "you@example.com")
  [[ -n $email ]] || { fail "an email is required"; return 1; }

  gum style --faint "  A passphrase prompt will appear. This passphrase protects"
  gum style --faint "  every password in your store — choose it carefully."
  echo

  # never-expiring key; gpg prompts for the passphrase through pinentry
  gpg --quick-generate-key "$name <$email>" default default never || return 1
  ok "key generated for $name <$email>"
  echo
}

# --- 3. password store ------------------------------------------------------

init_store() {
  heading "3/4  Password store"

  if [[ -f $STORE/.gpg-id ]]; then
    ok "store already initialised at $STORE"
    echo
    return 0
  fi

  local keys count fpr
  keys=$(secret_keys)
  [[ -n $keys ]] || { fail "no key to initialise the store with"; return 1; }

  count=$(wc -l <<<"$keys")
  if [[ $count -eq 1 ]]; then
    fpr=$(cut -f1 <<<"$keys")
    gum style --faint "  Using $(cut -f2 <<<"$keys")"
  else
    local choice
    choice=$(cut -f2 <<<"$keys" | gum choose --header "Encrypt the store to which key?") || return 1
    fpr=$(grep -F "$choice" <<<"$keys" | head -1 | cut -f1)
  fi

  pass init "$fpr" || return 1
  ok "store initialised at $STORE"

  if confirm "Track the store in git, so you can sync it between machines?"; then
    pass git init && ok "git initialised — add a remote with: pass git remote add origin <url>"
  fi
  echo
}

# --- 4. sanity check --------------------------------------------------------

verify() {
  heading "4/4  Check"

  local probe="omapass/setup-check"
  if pass generate -f "$probe" 12 >/dev/null 2>&1 && pass show "$probe" >/dev/null 2>&1; then
    pass rm -f "$probe" >/dev/null 2>&1
    ok "encrypt and decrypt both work"
  else
    fail "could not round-trip a test entry"
    warn "if the passphrase prompt never appeared, your pinentry may not be"
    warn "reachable from the desktop session. Try:"
    gum style --faint "    echo 'pinentry-program /usr/bin/pinentry-gnome3' >> ~/.gnupg/gpg-agent.conf"
    gum style --faint "    gpgconf --kill gpg-agent"
    return 1
  fi
  echo
}

# --- run --------------------------------------------------------------------

main() {
  has gum || { echo "omapass-setup needs gum" >&2; exit 1; }

  gum style --border rounded --padding "1 3" --border-foreground 4 \
    "$(gum style --bold '󰌾  omapass setup')" \
    "Get pass, a GPG key, and your password store ready."
  echo

  install_pass || { fail "setup stopped at the pass install"; exit 1; }
  setup_key || { fail "setup stopped at the GPG key"; exit 1; }
  init_store || { fail "setup stopped at the store"; exit 1; }
  verify || exit 1

  gum style --border rounded --padding "1 3" --border-foreground 2 \
    "$(gum style --bold 'omapass is ready')" \
    "Press SUPER + CTRL + K to open it."

  # Tell the running shell to re-check, so the overlay drops its setup screen.
  omarchy-shell shell call omapass refresh "" >/dev/null 2>&1 || true
}

main "$@"
